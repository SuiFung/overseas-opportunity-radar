{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity Radar Evidence",
  "type": "object",
  "required": ["collected_at", "results"],
  "properties": {
    "collected_at": {"type": "string"},
    "query": {"type": "string"},
    "days": {"type": "integer", "minimum": 1},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "records"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "category": {"type": "string"},
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "url", "summary", "evidence_type"],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "url": {"type": "string", "pattern": "^https?://"},
                "summary": {"type": "string"},
                "evidence_type": {"type": "string", "minLength": 1},
                "published_at": {"type": ["string", "null"]},
                "discussion_url": {"type": "string"},
                "signal": {"type": "object"}
              }
            }
          }
        }
      }
    }
  }
}
