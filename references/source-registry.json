  "sources": [
    {
      "id": "product-hunt",
      "category": "new-product",
      "label": "Product Hunt",
      "adapter": "opencli-json",
      "command": ["producthunt", "today"],
      "arguments": ["--limit", "{limit}"],
      "field_map": {
        "title": "name",
        "url": "url",
        "published_at": "date",
        "summary": "tagline",
        "signal": {"rank": "rank", "author": "author"}
      },
      "evidence_type": "Product Hunt current launch feed via OpenCLI",
      "domains": ["producthunt.com"],
      "date_policy": "keep-all",
      "purpose": "新发布的 AI 工具、SaaS、效率工具与消费应用；默认使用非浏览器命令以保持宽覆盖采集的响应速度"
    },
    {
      "id": "product-hunt-hot",
      "category": "leaderboard-candidate",
      "label": "Product Hunt 今日热门",
      "adapter": "opencli-json",
      "command": ["producthunt", "hot"],
      "arguments": ["--limit", "{limit}", "--window", "background"],
      "fallback": {
        "command": ["producthunt", "today"],
        "arguments": ["--limit", "{limit}"],
        "evidence_type": "Product Hunt current launch feed via OpenCLI fallback"
      },
      "field_map": {
        "title": "name",
        "url": "url",
        "summary": "tagline",
        "signal": {"rank": "rank", "votes": "votes"}
      },
      "evidence_type": "Product Hunt daily leaderboard via OpenCLI Chrome Bridge",
      "domains": ["producthunt.com"],
      "date_policy": "keep-all",
      "purpose": "Product Hunt 首页今日热门榜；需要可用的 OpenCLI Chrome Bridge，失败时回退为当日发布流"
    },
    {
      "id": "beta-list",
      "category": "new-product",
      "label": "BetaList Today & Yesterday",
      "adapter": "betalist-daily-list",
      "domains": ["betalist.com"],
      "date_policy": "keep-all",
      "purpose": "BetaList 首页 Today 与 Yesterday 的全量早期产品列表；每条保留产品页链接、名称、定位和所属日期"
    },
    {
      "id": "indie-hackers",
      "category": "new-product",
      "label": "Indie Hackers",
