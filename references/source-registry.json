    {
      "id": "github",
      "category": "tech-diffusion",
      "label": "GitHub",
      "adapter": "github-repositories",
      "purpose": "近期创建、获得 star 的开源项目与开发者工作流"
    },
    {
      "id": "github-trending",
      "category": "leaderboard-candidate",
      "label": "GitHub Trending（周榜）",
      "adapter": "opencli-json",
      "command": ["github-trending", "repos"],
      "arguments": ["--since", "weekly", "--limit", "{limit}"],
      "field_map": {
        "title": "repo",
        "url": "url",
        "summary": "description",
        "signal": {"rank": "rank", "stars": "stars", "forks": "forks", "stars_this_week": "starsSince", "language": "language"}
      },
      "evidence_type": "GitHub Trending weekly leaderboard via OpenCLI",
      "purpose": "本周 star 增长最快的开源产品和开发者工具"
    },
    {
